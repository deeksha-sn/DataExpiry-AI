# ==============================================================================
# DATAEXPIRY-AI — Environment Variable Blueprint
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and customize as needed.
# NEVER commit real credentials, passwords, or API keys to version control.

# Application Information
PROJECT_NAME="DATAEXPIRY API"
VERSION="1.0.0"
API_V1_STR="/api"

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Connection URL
# Local SQLite default (relative to working directory):
DATABASE_URL=sqlite:///./dataexpiry.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/dataexpiry

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# AI Governance Engine Configuration (Google Gemini)
# Leave blank to run 100% offline with the deterministic rule-based NLP engine.
GEMINI_API_KEY=
AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini Free-Tier & Rate Limiting Optimization
GEMINI_RPM_LIMIT=10
GEMINI_RATE_LIMIT_RPM=10
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=8.0
GEMINI_CACHE_TTL_SECONDS=3600
GEMINI_CACHE_MAX_ENTRIES=1000
GEMINI_SKIP_IDENTICAL_PURPOSE=true

# Security Configuration
# Explicit opt-in required to allow X-User-Role / X-User-Id header assertion in development mode.
# When False (default), identity falls back to least-privileged 'VIEWER' and fails closed.
ALLOW_DEV_HEADER_AUTH=false
