# Database Configuration (SQLite default, PostgreSQL ready)
# Local SQLite: sqlite:///./dataexpiry.db
# PostgreSQL Example: postgresql://username:password@localhost:5432/dataexpiry
DATABASE_URL=sqlite:///./dataexpiry.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Placeholder for future AI integration (Team Member 2)
# App runs seamlessly without this key at the current foundation stage
AI_API_KEY=
