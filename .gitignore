# ==============================================================================
# DATAEXPIRY-AI — Git Ignore Configuration
# ==============================================================================

# Environment Variables & Secrets (NEVER commit secrets or credentials)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt
id_rsa*
id_ed25519*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# SQLite Database Files & Backups (Preserve local data; never track in git)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak
*.backup
dataexpiry.db
backend/dataexpiry.db

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Jupyter Runtime Files & Notebook Checkpoints
.ipynb_checkpoints/
*.ipynb

# OS & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Temporary State
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Logs and runtime artifacts
logs/
*.log
